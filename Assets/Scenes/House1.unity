--- !u!114 &1490111312
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1490111303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc117823bf1d26d41b197b2fae7339d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestNPC
  beforeQuestDialogue:
    speaker:
    - NPC
    dialogue:
    - I got the Key for my Bar, the problem is that those Thugs outside won't let
      me! Can you defeat them for me?
    portraits:
    - {fileID: -489854404, guid: c145706410a005d49aa75783afffe686, type: 3}
  questInProgressDialogue:
    speaker:
    - NPC
    - NPC
    - NPC
    dialogue:
    - What are you doing? I can't leave like this!
    - Hey look man, I know your busy and everything but I still can't leave!
    - You want the key or not? GO TAKE CARE OF THEM!
    portraits:
    - {fileID: -489854404, guid: c145706410a005d49aa75783afffe686, type: 3}
    - {fileID: -489854404, guid: c145706410a005d49aa75783afffe686, type: 3}
    - {fileID: -489854404, guid: c145706410a005d49aa75783afffe686, type: 3}
  questCompleteDialogue:
    speaker:
    - NPC
    dialogue:
    - Oh wow! You did it! I didn't know you had it in you! Well if I didn't I don't
      know why I even asked but hey you defeated them! Here's the Key!
    portraits:
    - {fileID: -489854404, guid: c145706410a005d49aa75783afffe686, type: 3}
  postQuestDialogue:
    speaker:
    - NPC
    - NPC
    dialogue:
    - Thanks for all your help!
    - Get out of my house.
    portraits:
